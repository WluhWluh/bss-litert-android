+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.google.ai.edge.litert;
+
+import java.io.File;
+import java.io.IOException;
+
+/** Configures and loads the split native libraries used by the LiteRT Kotlin API. */
+public final class LiteRtNativeLibraryLoader {
+  private static final String RUNTIME_LIBRARY_FILE_NAME = "libLiteRt.so";
+  private static final String JNI_LIBRARY_FILE_NAME = "liblitert_jni.so";
+  private static final String DEFAULT_JNI_LIBRARY_NAME = "litert_jni";
+  private static final Object LOCK = new Object();
+
+  private static volatile String configuredRuntimePath;
+  private static volatile boolean loaded;
+  private static volatile String loadedRuntimePath;
+  private static volatile String loadedJniPath;
+
+  private LiteRtNativeLibraryLoader() {}
+
+  /** Configures the absolute runtime path before any LiteRT API class is initialized. */
+  public static void configureAbsolutePath(String absolutePath) {
+    File file = new File(absolutePath);
+    if (!file.isAbsolute()) {
+      throw new IllegalArgumentException(
+          "LiteRT runtime library path must be absolute: " + absolutePath);
+    }
+    if (!RUNTIME_LIBRARY_FILE_NAME.equals(file.getName())) {
+      throw new IllegalArgumentException(
+          "LiteRT runtime library must be named " + RUNTIME_LIBRARY_FILE_NAME);
+    }
+    String normalizedPath = canonicalPath(file);
+
+    synchronized (LOCK) {
+      if (loaded) {
+        if (normalizedPath.equals(loadedRuntimePath)) {
+          return;
+        }
+        throw new IllegalStateException("LiteRT native libraries are already loaded");
+      }
+      if (configuredRuntimePath != null && !configuredRuntimePath.equals(normalizedPath)) {
+        throw new IllegalStateException(
+            "LiteRT runtime library path is already configured: " + configuredRuntimePath);
+      }
+      configuredRuntimePath = normalizedPath;
+    }
+  }
+
+  /** Loads the configured runtime then JNI library, or the packaged JNI library if unconfigured. */
+  public static void load() {
+    synchronized (LOCK) {
+      if (loaded) {
+        return;
+      }
+      String runtimePath = configuredRuntimePath;
+      if (runtimePath == null) {
+        System.loadLibrary(DEFAULT_JNI_LIBRARY_NAME);
+        loadedRuntimePath = null;
+        loadedJniPath = null;
+      } else {
+        String jniPath = siblingJniPath(runtimePath);
+        System.load(runtimePath);
+        System.load(jniPath);
+        loadedRuntimePath = runtimePath;
+        loadedJniPath = jniPath;
+      }
+      loaded = true;
+    }
+  }
+
+  /** Returns whether this API class loader has completed native-library loading. */
+  public static boolean isLoaded() {
+    return loaded;
+  }
+
+  /** Returns the configured canonical runtime path, or null for packaged-library fallback. */
+  public static String configuredAbsolutePath() {
+    return configuredRuntimePath;
+  }
+
+  /** Returns the derived canonical JNI path, or null for packaged-library fallback. */
+  public static String configuredJniAbsolutePath() {
+    String runtimePath = configuredRuntimePath;
+    return runtimePath == null ? null : siblingJniPath(runtimePath);
+  }
+
+  private static String siblingJniPath(String runtimePath) {
+    File parent = new File(runtimePath).getParentFile();
+    if (parent == null) {
+      throw new IllegalArgumentException("LiteRT runtime library has no parent directory");
+    }
+    return canonicalPath(new File(parent, JNI_LIBRARY_FILE_NAME));
+  }
+
+  private static String canonicalPath(File file) {
+    try {
+      return file.getCanonicalPath();
+    } catch (IOException error) {
+      throw new IllegalArgumentException("Unable to canonicalize LiteRT native library path", error);
+    }
+  }
+}
