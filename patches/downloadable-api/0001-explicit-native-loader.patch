+package com.google.ai.edge.litert
+
+import java.io.File
+
+/** Configures and loads the native library used by the LiteRT Kotlin API. */
+object LiteRtNativeLibraryLoader {
+  private const val DEFAULT_LIBRARY_NAME = "LiteRt"
+  private val lock = Any()
+
+  @Volatile private var configuredPath: String? = null
+  @Volatile private var loaded = false
+  @Volatile private var loadedPath: String? = null
+
+  /** Configures an absolute native-library path before any LiteRT API class is initialized. */
+  @JvmStatic
+  fun configureAbsolutePath(absolutePath: String) {
+    val file = File(absolutePath)
+    require(file.isAbsolute) { "LiteRT native library path must be absolute: $absolutePath" }
+    val normalizedPath = file.canonicalPath
+
+    synchronized(lock) {
+      if (loaded) {
+        if (loadedPath == normalizedPath) return
+        throw IllegalStateException("LiteRT native library is already loaded")
+      }
+      val existingPath = configuredPath
+      if (existingPath != null && existingPath != normalizedPath) {
+        throw IllegalStateException(
+          "LiteRT native library path is already configured: $existingPath"
+        )
+      }
+      configuredPath = normalizedPath
+    }
+  }
+
+  /** Loads the configured native library, or the packaged `LiteRt` library when unconfigured. */
+  @JvmStatic
+  fun load() {
+    synchronized(lock) {
+      if (loaded) return
+      val path = configuredPath
+      if (path == null) {
+        System.loadLibrary(DEFAULT_LIBRARY_NAME)
+      } else {
+        System.load(path)
+      }
+      loadedPath = path
+      loaded = true
+    }
+  }
+
+  /** Returns whether this API class loader has completed native-library loading. */
+  @JvmStatic fun isLoaded(): Boolean = loaded
+
+  /** Returns the configured canonical path, or null when packaged-library fallback is selected. */
+  @JvmStatic fun configuredAbsolutePath(): String? = configuredPath
+}
