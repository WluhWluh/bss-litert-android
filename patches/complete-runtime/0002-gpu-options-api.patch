+TEST(GpuAcceleratorPayload, SetAndGetCommandQueueWindowSize) {
+  LrtGpuOptions* payload = nullptr;
+  LITERT_ASSERT_OK(LrtCreateGpuOptions(&payload));
+
+  int command_queue_window_size = -1;
+  LITERT_EXPECT_OK(
+      LrtGetGpuAcceleratorRuntimeOptionsCommandQueueWindowSize(
+          &command_queue_window_size, payload));
+  EXPECT_EQ(command_queue_window_size, 0);
+
+  LITERT_EXPECT_OK(
+      LrtSetGpuAcceleratorRuntimeOptionsCommandQueueWindowSize(payload, 1));
+  LITERT_EXPECT_OK(
+      LrtGetGpuAcceleratorRuntimeOptionsCommandQueueWindowSize(
+          &command_queue_window_size, payload));
+  EXPECT_EQ(command_queue_window_size, 1);
+
+  LrtGpuOptions* payload_from_toml = nullptr;
+  SerializeAndParse(payload, &payload_from_toml);
+
+  int command_queue_window_size_from_toml = 0;
+  LITERT_EXPECT_OK(
+      LrtGetGpuAcceleratorRuntimeOptionsCommandQueueWindowSize(
+          &command_queue_window_size_from_toml, payload_from_toml));
+  EXPECT_EQ(command_queue_window_size_from_toml, 1);
+
+  EXPECT_EQ(LrtSetGpuAcceleratorRuntimeOptionsCommandQueueWindowSize(
+                payload, -1),
+            kLiteRtStatusErrorInvalidArgument);
+  EXPECT_EQ(LrtSetGpuAcceleratorRuntimeOptionsCommandQueueWindowSize(
+                payload, 1025),
+            kLiteRtStatusErrorInvalidArgument);
+
+  LrtDestroyGpuOptions(payload_from_toml);
+  LrtDestroyGpuOptions(payload);
+}
