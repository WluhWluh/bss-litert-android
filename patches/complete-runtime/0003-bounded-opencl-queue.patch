--- a/ml_drift_delegate/delegate/gpu_backend_opencl_litert.cc
+++ b/ml_drift_delegate/delegate/gpu_backend_opencl_litert.cc
@@ -430,11 +430,24 @@ absl::Status GpuInferenceContextOpenClLitert::Dispatch() {
 
   // Otherwise, dispatch kernels in batches of size kernel_batch_size.
   int offset = 0;
+  int batches_since_wait = 0;
   do {
     ASSIGN_OR_RETURN(offset,
                      cl_ctx().AddToQueue(cl_env()->queue(), offset,
                                          current_backend->kernel_batch_size()));
+    ++batches_since_wait;
+    const bool wait_for_boundary =
+        current_backend->command_queue_window_size() > 0 &&
+        batches_since_wait >= current_backend->command_queue_window_size();
+    ::ml_drift::cl::CLEvent boundary_event;
+    if (wait_for_boundary) {
+      RETURN_IF_ERROR(cl_env()->queue()->EnqueueEvent(&boundary_event));
+    }
     ::ml_drift::cl::clFlush(cl_env()->queue()->queue());
+    if (wait_for_boundary) {
+      boundary_event.Wait();
+      batches_since_wait = 0;
+    }
   } while (offset != -1);
   return absl::OkStatus();
 }
