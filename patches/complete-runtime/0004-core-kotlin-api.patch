+    exports_manifest = 1,
+    javacopts = ["--release 17"],
+    kotlinc_opts = ":bss_litert_kotlinc_options",
+    manifest = "src/core/AndroidManifest.xml",
+    visibility = ["//visibility:public"],
+)
+
